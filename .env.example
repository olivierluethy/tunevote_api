# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The app loads these via dotenv at startup.

# --- Database (MySQL) ---
# How the Node backend connects. In production the DB listens only on the VPS's
# loopback (127.0.0.1:3306) — never on a public interface — so DB_HOST stays
# localhost. To connect from your workstation, open an SSH tunnel first (see
# docs/2026-08-26-database-security-architecture.md); never expose port 3306.
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=change_me
DB_NAME=tunevote
DB_PORT=3306

# --- Docker Compose: MySQL container provisioning (interpolated by docker-compose.yml) ---
# These initialise the local MySQL container on first `docker compose up`. They
# are secrets — set them in .env only, never commit real values. MYSQL_USER /
# MYSQL_PASSWORD should match DB_USER / DB_PASSWORD above so the app can log in.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=tunevote
MYSQL_USER=user
MYSQL_PASSWORD=change_me

# --- Auth ---
JWT_SECRET=change_me_long_random_string

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Facebook OAuth ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# --- Email (Infomaniak SMTP — used by password reset, new-password & invites) ---
# Sender is "TuneVote" <hello@tunevote.ch>. The From domain MUST be tunevote.ch
# so SPF/DKIM/DMARC align (see DNS notes in DEPLOYMENT.md). SMTP_PASS is a secret —
# fill it in .env only, never commit it.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@tunevote.ch
SMTP_PASS=change_me

# --- Email (legacy cPanel SMTP, secondary — unused) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- YouTube Data API v3 ---
YOUTUBE_KEY=

# --- App ---
# Public base URL of the web app. Used to build password-reset links and to
# reference email assets (the logo). No trailing slash needed — it is trimmed.
APP_URL=https://app.tunevote.com
FRONTEND_URL=http://localhost:5173/
NODE_ENV=development
AUTOFILL_DISABLED=false

# --- Deployment (SSH to the VPS) — used by DEPLOYMENT.md, never committed ---
DEPLOY_SSH_HOST=            # the VPS IP address ("the number")
DEPLOY_SSH_USER=            # SSH username
DEPLOY_SSH_PASSWORD=        # SSH password (or leave blank and use an SSH key)
DEPLOY_SSH_PORT=22
DEPLOY_DB_ROOT_PASSWORD=    # MySQL root password, for backups/migrations if the app user lacks privileges
