# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The app loads these via dotenv at startup.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=change_me
DB_NAME=tunevote
DB_PORT=3306

# --- Auth ---
JWT_SECRET=change_me_long_random_string

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Facebook OAuth ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# --- Email (Gmail — used by password reset & invites) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Email (legacy cPanel SMTP, secondary) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- YouTube Data API v3 ---
YOUTUBE_KEY=

# --- App ---
FRONTEND_URL=http://localhost:5173/
NODE_ENV=development
AUTOFILL_DISABLED=false
