# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The app loads these via dotenv at startup.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=change_me
DB_NAME=tunevote
DB_PORT=3306

# --- Auth ---
JWT_SECRET=change_me_long_random_string

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Facebook OAuth ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# --- Email (Infomaniak SMTP — used by password reset, new-password & invites) ---
# Sender is "TuneVote" <hello@tunevote.ch>. The From domain MUST be tunevote.ch
# so SPF/DKIM/DMARC align (see DNS notes in DEPLOYMENT.md). SMTP_PASS is a secret —
# fill it in .env only, never commit it.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@tunevote.ch
SMTP_PASS=change_me

# --- Email (legacy cPanel SMTP, secondary — unused) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- YouTube Data API v3 ---
YOUTUBE_KEY=

# --- App ---
FRONTEND_URL=http://localhost:5173/
NODE_ENV=development
AUTOFILL_DISABLED=false

# --- Deployment (SSH to the VPS) — used by DEPLOYMENT.md, never committed ---
DEPLOY_SSH_HOST=            # the VPS IP address ("the number")
DEPLOY_SSH_USER=            # SSH username
DEPLOY_SSH_PASSWORD=        # SSH password (or leave blank and use an SSH key)
DEPLOY_SSH_PORT=22
DEPLOY_DB_ROOT_PASSWORD=    # MySQL root password, for backups/migrations if the app user lacks privileges
